{
  "name": "steward-personal-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env.local server/index.js",
    "build": "tsc -b && vite build",
